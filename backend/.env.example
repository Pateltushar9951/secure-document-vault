# ── App ───────────────────────────────────────────────────────
APP_NAME="Secure Document Vault"
APP_VERSION="1.0.0"
DEBUG=True                        # Set False in production

# ── Security ──────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=IMRE1KC4Z9t1KX915NAWNa5u1QEZid4CInHfwNd-3ec=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=2688c6aec8f09dca04f581503f22688039081df8e3169a65665a910b03ce1527
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database (MongoDB Atlas) ──────────────────────────────
# Get connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/database
MONGODB_URI=mongodb+srv://pateltushar9951_db_user:Uz4fSnM99yr6eVK9@cluster.mongodb.net/secure_vault?retryWrites=true&w=majority
MONGODB_DB_NAME=secure_vault

# ── Storage ───────────────────────────────────────────────────
STORAGE_DIR=storage
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg

# ── OTP ───────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6

